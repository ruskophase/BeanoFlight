# Separate database, port and secret for each environment. Never repoint a
# simulation database as real; the immutable world marker rejects it.
BEANOSORT_ENVIRONMENT=simulation
BEANOSORT_DATABASE_URL=sqlite:///./var/training.db
BEANOSORT_PUBLIC_URL=http://127.0.0.1:8090
BEANOSORT_TIMEZONE=Africa/Johannesburg
BEANOSORT_STATION_STALE_SECONDS=30
# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(48))'
BEANOSORT_SECRET=replace-with-a-long-random-secret-before-starting
BEANOSORT_SECURE_COOKIES=0
# PostgreSQL example (credentials supplied locally, never committed):
# BEANOSORT_DATABASE_URL=postgresql+psycopg://beanosort:password@127.0.0.1:5432/beanosort_training
# Set SECURE_COOKIES=1 when served behind HTTPS.

# Default manual machine-control service; editable in Sorter Controls.
BEANOSORT_SORTER_HOST=127.0.0.1
BEANOSORT_SORTER_PORT=8000
